// The document a deployer copies from: six Fastmail key providers, one
// holding read-only mail tokens, one holding read-write mail tokens, one
// holding read-only contacts tokens, one holding read-write contacts tokens,
// one holding calendar app passwords and one holding calendar app passwords
// that may write; the `fastmail-mail-read`, `fastmail-mail-write`,
// `fastmail-contacts`, `fastmail-contacts-write`, `fastmail-calendar` and
// `fastmail-calendar-write` instances, each with the clauses it calls through
// on its own provider; and an agent granted the nineteen tools.
//
// `example_fit` compiles it against the two module roots a host resolves it
// from, this bundle's and brenn's; `config_check` lowers it with the verb an
// installer runs. Neither reads a key file or touches a path, so the paths
// below are a deployment's shape, not files this checkout holds.
use @fastmail-mail-read::*;
use @fastmail-mail-write::*;
use @fastmail-contacts::*;
use @fastmail-contacts-write::*;
use @fastmail-calendar::*;
use @fastmail-calendar-write::*;

server {
  bind_address = "127.0.0.1:3000";
  static_dir = "/opt/brenn/current/frontend";
  secure_cookies = true;
  public_url = "https://brenn.example.com";
}

database {
  path = "/var/lib/brenn/brenn.db";
}

logging {
  log_dir = "/var/log/brenn";
  console_level = info;
  file_level = info;
}

claude_defaults {
  mcp_script_path = "/opt/brenn/current/mcp/brenn_mcp.py";
  model = "sonnet";
}

/// A read's answer is Fastmail's JSON body as a string inside the nested
/// call's result inside the tool-result envelope, so escaping grows it. This
/// carries `api-request`'s default 256 KiB `max_response_bytes` with margin.
/// Lowering `max_response_bytes` instead is the other way to fit.
messaging {
  max_body_bytes = 393216;
}

// Every deployment publishes its surface index here, with or without a page;
// config-check refuses a document that leaves the channel undeclared.
channel surface_index at "brenn:surface.index" {
  push_depth = 1;
  retain_depth = 1;
  standing_retain_depth = 1;
}

container sandbox {
  image = "example.com/cc:latest";
  home_dir = "/var/lib/brenn/home";
}

/// The read component's tokens. One `account` per Fastmail account, each
/// bound to the brenn user whose mail it is; a tool reads the calling user's.
/// Each key file holds `Bearer <token>`, mode 0600, owned by the brenn user;
/// the token is a Fastmail API token with read-only mail access, so nothing
/// the read instance does can change the account. alice has two accounts and
/// reads `alice` unless a call names `alice-work`; bob has one. Every user
/// named must be registered before boot. A key provider is read at boot, so
/// changing this block takes a restart.
api_key_provider fastmail {
  header = "Authorization";
  api_hosts = ["https://api.fastmail.com"];
  account alice {
    user = "alice";
    key_file = "/etc/brenn/fastmail/alice";
    default = true;
  }
  account alice-work {
    user = "alice";
    key_file = "/etc/brenn/fastmail/alice-work";
  }
  account bob {
    user = "bob";
    key_file = "/etc/brenn/fastmail/bob";
  }
}

/// The write component's tokens: the same accounts under the same names and
/// with the same `default`, so an agent's `account`, or its omission, means
/// the same mailbox to both components, each key file holding a Fastmail API
/// token with read-write access to mail.
api_key_provider fastmail-write {
  header = "Authorization";
  api_hosts = ["https://api.fastmail.com"];
  account alice {
    user = "alice";
    key_file = "/etc/brenn/fastmail-write/alice";
    default = true;
  }
  account alice-work {
    user = "alice";
    key_file = "/etc/brenn/fastmail-write/alice-work";
  }
  account bob {
    user = "bob";
    key_file = "/etc/brenn/fastmail-write/bob";
  }
}

/// The contacts component's tokens: the same accounts under the same names
/// and with the same `default`, each key file holding a Fastmail API token
/// with read-only access to contacts, so nothing the contacts instance does
/// can change the account.
api_key_provider fastmail-contacts {
  header = "Authorization";
  api_hosts = ["https://api.fastmail.com"];
  account alice {
    user = "alice";
    key_file = "/etc/brenn/fastmail-contacts/alice";
    default = true;
  }
  account alice-work {
    user = "alice";
    key_file = "/etc/brenn/fastmail-contacts/alice-work";
  }
  account bob {
    user = "bob";
    key_file = "/etc/brenn/fastmail-contacts/bob";
  }
}

/// The contacts write component's tokens: the same accounts under the same
/// names and with the same `default`, each key file holding a Fastmail API
/// token with read-write access to contacts. Only the contacts write
/// instance names this provider.
api_key_provider fastmail-contacts-write {
  header = "Authorization";
  api_hosts = ["https://api.fastmail.com"];
  account alice {
    user = "alice";
    key_file = "/etc/brenn/fastmail-contacts-write/alice";
    default = true;
  }
  account alice-work {
    user = "alice";
    key_file = "/etc/brenn/fastmail-contacts-write/alice-work";
  }
  account bob {
    user = "bob";
    key_file = "/etc/brenn/fastmail-contacts-write/bob";
  }
}

/// The calendar component's app passwords. Each key file holds
/// `Basic <base64 of address:app-password>`. The same accounts under the
/// same names and with the same `default`.
api_key_provider fastmail-calendar {
  header = "Authorization";
  api_hosts = ["https://caldav.fastmail.com"];
  account alice {
    user = "alice";
    key_file = "/etc/brenn/fastmail-calendar/alice";
    default = true;
  }
  account alice-work {
    user = "alice";
    key_file = "/etc/brenn/fastmail-calendar/alice-work";
  }
  account bob {
    user = "bob";
    key_file = "/etc/brenn/fastmail-calendar/bob";
  }
}

// Each live request has one nested call outstanding: the class's summed
// `max_concurrency` (12) results can arrive between two activations, twice
// over if one is re-delivered, so `retain_depth` is at least 24, rounded up.
channel at "brenn:tool-results/fastmail_mail" {
  push_depth = 1;
  retain_depth = 32;
  standing_retain_depth = 32;
  noise = alarm;
}

/// Every tool reads the session document, then posts one JMAP envelope; the
/// thread tool posts a second. The API path has no trailing slash: brenn
/// refuses a clause or a request path with an empty segment.
new fastmail_mail: FastmailMailRead {
  grants = [log, store, config, tools, provides];
  store_path = "/var/lib/brenn/stores/fastmail_mail";
  tool api-request {
    allow { provider = "fastmail"; method = "GET";  host = "api.fastmail.com"; path = "/jmap/session"; }
    allow { provider = "fastmail"; method = "POST"; host = "api.fastmail.com"; path = "/jmap/api"; }
    rate_limit { burst = 20; sustained_per_minute = 60; }
  }
  config = {
    provider = "fastmail",
    host = "api.fastmail.com"
  };
}

// The write class's summed `max_concurrency` is 6, so 2 × 6 = 12 fits the
// family default of 16; the block is declared so `noise = alarm` holds.
channel at "brenn:tool-results/fastmail_mail_write" {
  push_depth = 1;
  retain_depth = 16;
  standing_retain_depth = 16;
  noise = alarm;
}

/// Every tool reads the session document, then posts one JMAP envelope; a
/// draft posts a second, its write. The instance calls through the
/// read-write provider.
new fastmail_mail_write: FastmailMailWrite {
  grants = [log, store, config, tools, provides];
  store_path = "/var/lib/brenn/stores/fastmail_mail_write";
  tool api-request {
    allow { provider = "fastmail-write"; method = "GET";  host = "api.fastmail.com"; path = "/jmap/session"; }
    allow { provider = "fastmail-write"; method = "POST"; host = "api.fastmail.com"; path = "/jmap/api"; }
    rate_limit { burst = 20; sustained_per_minute = 60; }
  }
  config = {
    provider = "fastmail-write",
    host = "api.fastmail.com"
  };
}

// The contacts class's summed `max_concurrency` is 10, so 2 × 10 = 20 rounds
// up to 32; the family default of 16 does not hold it.
channel at "brenn:tool-results/fastmail_contacts" {
  push_depth = 1;
  retain_depth = 32;
  standing_retain_depth = 32;
  noise = alarm;
}

/// Every tool reads the session document, then posts one JMAP envelope. The
/// instance calls through the contacts provider and writes nothing.
new fastmail_contacts: FastmailContacts {
  grants = [log, store, config, tools, provides];
  store_path = "/var/lib/brenn/stores/fastmail_contacts";
  tool api-request {
    allow { provider = "fastmail-contacts"; method = "GET";  host = "api.fastmail.com"; path = "/jmap/session"; }
    allow { provider = "fastmail-contacts"; method = "POST"; host = "api.fastmail.com"; path = "/jmap/api"; }
    rate_limit { burst = 20; sustained_per_minute = 60; }
  }
  config = {
    provider = "fastmail-contacts",
    host = "api.fastmail.com"
  };
}

// The contacts write class's summed `max_concurrency` is 4, so 2 × 4 = 8 fits
// the family default of 16; the block is declared so `noise = alarm` holds.
channel at "brenn:tool-results/fastmail_contacts_write" {
  push_depth = 1;
  retain_depth = 16;
  standing_retain_depth = 16;
  noise = alarm;
}

/// A create reads the session document, then posts its write; an update
/// posts a read of the contact and then its write. The instance calls
/// through the contacts read-write provider.
new fastmail_contacts_write: FastmailContactsWrite {
  grants = [log, store, config, tools, provides];
  store_path = "/var/lib/brenn/stores/fastmail_contacts_write";
  tool api-request {
    allow { provider = "fastmail-contacts-write"; method = "GET";  host = "api.fastmail.com"; path = "/jmap/session"; }
    allow { provider = "fastmail-contacts-write"; method = "POST"; host = "api.fastmail.com"; path = "/jmap/api"; }
    rate_limit { burst = 20; sustained_per_minute = 60; }
  }
  config = {
    provider = "fastmail-contacts-write",
    host = "api.fastmail.com"
  };
}

// The calendar class's summed `max_concurrency` is 10, so 2 × 10 = 20 rounds
// up to 32; the family default of 16 does not hold it.
channel at "brenn:tool-results/fastmail_calendar" {
  push_depth = 1;
  retain_depth = 32;
  standing_retain_depth = 32;
  noise = alarm;
}

/// The calendar list asks for the credential's principal, then its calendar
/// home, then the calendars in it; a window is one `REPORT` of a calendar
/// and an event one `GET`. The clauses admit no writing method, whatever the
/// app password can do, and hold the paths Fastmail's help pages give: a
/// discovered path of another shape is refused naming the clause, and the
/// fix is the clause.
new fastmail_calendar: FastmailCalendar {
  grants = [log, store, config, tools, provides];
  store_path = "/var/lib/brenn/stores/fastmail_calendar";
  tool api-request {
    allow { provider = "fastmail-calendar"; method = "PROPFIND"; host = "caldav.fastmail.com"; path = "/dav/principals/"; }
    allow { provider = "fastmail-calendar"; method = "PROPFIND"; host = "caldav.fastmail.com"; path = "/dav/principals/user/*/"; }
    allow { provider = "fastmail-calendar"; method = "PROPFIND"; host = "caldav.fastmail.com"; path = "/dav/calendars/user/*/"; }
    allow { provider = "fastmail-calendar"; method = "REPORT";   host = "caldav.fastmail.com"; path = "/dav/calendars/user/*/*/"; }
    allow { provider = "fastmail-calendar"; method = "GET";      host = "caldav.fastmail.com"; path = "/dav/calendars/user/*/*/*"; }
    rate_limit { burst = 20; sustained_per_minute = 60; }
  }
  config = {
    provider = "fastmail-calendar",
    host = "caldav.fastmail.com"
  };
}

/// The calendar write component's app passwords: `Basic <base64 of
/// address:app-password>`, a password that may write calendars. The same
/// accounts under the same names and with the same `default`.
api_key_provider fastmail-calendar-write {
  header = "Authorization";
  api_hosts = ["https://caldav.fastmail.com"];
  account alice {
    user = "alice";
    key_file = "/etc/brenn/fastmail-calendar-write/alice";
    default = true;
  }
  account alice-work {
    user = "alice";
    key_file = "/etc/brenn/fastmail-calendar-write/alice-work";
  }
  account bob {
    user = "bob";
    key_file = "/etc/brenn/fastmail-calendar-write/bob";
  }
}

// The calendar write class's summed `max_concurrency` is 6, so 2 × 6 = 12
// fits the family default of 16; the block is declared so `noise = alarm` holds.
channel at "brenn:tool-results/fastmail_calendar_write" {
  push_depth = 1;
  retain_depth = 16;
  standing_retain_depth = 16;
  noise = alarm;
}

/// A create is one `PUT` of a new event; an update reads the event and
/// writes it back, and a delete reads it and removes it, each only if the
/// event is still the one that was read. Dropping the `DELETE` clause and
/// the agent's `fastmail-calendar-event-delete` grant leaves a deployment
/// creating and changing without deleting.
new fastmail_calendar_write: FastmailCalendarWrite {
  grants = [log, store, config, tools, provides];
  store_path = "/var/lib/brenn/stores/fastmail_calendar_write";
  tool api-request {
    allow { provider = "fastmail-calendar-write"; method = "GET";    host = "caldav.fastmail.com"; path = "/dav/calendars/user/*/*/*"; }
    allow { provider = "fastmail-calendar-write"; method = "PUT";    host = "caldav.fastmail.com"; path = "/dav/calendars/user/*/*/*"; }
    allow { provider = "fastmail-calendar-write"; method = "DELETE"; host = "caldav.fastmail.com"; path = "/dav/calendars/user/*/*/*"; }
    rate_limit { burst = 20; sustained_per_minute = 60; }
  }
  config = {
    provider = "fastmail-calendar-write",
    host = "caldav.fastmail.com"
  };
}

agent Assistant() {
  working_dir = ".";
  container = "sandbox";
  container_working_dir = "/work";
  tool fastmail-mailboxes {}
  tool fastmail-search {}
  tool fastmail-read {}
  tool fastmail-thread {}
  tool fastmail-organize {}
  tool fastmail-mailbox-create {}
  tool fastmail-mailbox-update {}
  tool fastmail-draft {}
  tool fastmail-address-books {}
  tool fastmail-contact-search {}
  tool fastmail-contact-read {}
  tool fastmail-contact-create {}
  tool fastmail-contact-update {}
  tool fastmail-calendars {}
  tool fastmail-calendar-events {}
  tool fastmail-calendar-event {}
  tool fastmail-calendar-event-create {}
  tool fastmail-calendar-event-update {}
  tool fastmail-calendar-event-delete {}
}

new assistant: Assistant();
