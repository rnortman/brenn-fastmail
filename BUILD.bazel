load("@brenn//bazel/wasm:defs.bzl", "component_bundle", "component_package", "config_fit_test", "deployed_components_test", "grant_parity_test")
load("@buildifier_prebuilt//:rules.bzl", "buildifier", "buildifier_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# The root package publishes the files other packages and the module
# extensions read.
exports_files([
    "Cargo.toml",
    "Cargo.lock",
    "MODULE.bazel",
    "cargo-bazel-lock.json",
    "clippy.toml",
    "deployed-components.txt",
    "rust-toolchain.toml",
    "rustfmt.toml",
])

# BUILD-file formatting and lint. The test scans the whole workspace rather
# than a `srcs` list because a glob in the root package cannot see files in
# other packages; `no_sandbox` is what buildifier_prebuilt requires for that,
# and the wrapper tags the test no-cache so it always reruns.
BUILDIFIER_EXCLUDES = [
    "./.git/*",
    "./.bazel-*/*",
]

buildifier(
    name = "buildifier",
    exclude_patterns = BUILDIFIER_EXCLUDES,
    lint_mode = "fix",
    mode = "fix",
)

buildifier_test(
    name = "buildifier_test",
    size = "small",
    exclude_patterns = BUILDIFIER_EXCLUDES,
    lint_mode = "warn",
    mode = "diff",
    no_sandbox = True,
    workspace = "//:MODULE.bazel",
)

# The release: three backend packages, `fastmail-contacts`,
# `fastmail-mail-read` and `fastmail-mail-write`, each built from its component
# artifact and its authored specification.
component_package(
    name = "fastmail-contacts_package",
    component = "//fastmail-contacts:component",
    package = "fastmail-contacts",
    spec = "//spec:fastmail-contacts.brenn",
    world = "brenn:processor",
)

component_package(
    name = "fastmail-mail-read_package",
    component = "//fastmail-mail-read:component",
    package = "fastmail-mail-read",
    spec = "//spec:fastmail-mail-read.brenn",
    world = "brenn:processor",
)

component_package(
    name = "fastmail-mail-write_package",
    component = "//fastmail-mail-write:component",
    package = "fastmail-mail-write",
    spec = "//spec:fastmail-mail-write.brenn",
    world = "brenn:processor",
)

# The capabilities each artifact imports against the ones its specification
# declares.
grant_parity_test(
    name = "fastmail-contacts_grant_parity",
    component = "//fastmail-contacts:component",
    spec = "//spec:fastmail-contacts.brenn",
)

grant_parity_test(
    name = "fastmail-mail-read_grant_parity",
    component = "//fastmail-mail-read:component",
    spec = "//spec:fastmail-mail-read.brenn",
)

grant_parity_test(
    name = "fastmail-mail-write_grant_parity",
    component = "//fastmail-mail-write:component",
    spec = "//spec:fastmail-mail-write.brenn",
)

deployed_components_test(
    name = "deployed_components_test",
    manifest = "deployed-components.txt",
    packages = [
        ":fastmail-contacts_package",
        ":fastmail-mail-read_package",
        ":fastmail-mail-write_package",
    ],
)

# The tree a deployment installs: `components/` and `modules/`, the staged
# `modules/` byte-equal to the authored specification root.
component_bundle(
    name = "bundle",
    manifest = "deployed-components.txt",
    packages = [
        ":fastmail-contacts_package",
        ":fastmail-mail-read_package",
        ":fastmail-mail-write_package",
    ],
    spec_root = ["//spec:modules"],
    visibility = ["//visibility:public"],
)

# The module roots a deployment resolves the example document against: this
# bundle's and brenn's. Named once so the fit and the lowering gate check the
# same root set.
DEPLOYMENT_MODULE_ROOTS = [
    "//spec:modules",
    "@brenn//:modules",
]

# TODO(quality-readme-config-excerpts-unguarded-and-doubled): nothing holds
# the README's configuration excerpts equal to the example document.
config_fit_test(
    name = "example_fit",
    config = "config/example.brenn",
    modules = DEPLOYMENT_MODULE_ROOTS,
)

# The example document lowered by `brenn config-check`, the verb an installer
# runs before it stops the service.
sh_test(
    name = "config_check",
    size = "small",
    srcs = ["tools/config_check.sh"],
    args = [
        "$(rootpath @brenn//brenn:brenn)",
        "$(rootpaths //spec:modules)",
        "$(rootpaths @brenn//:modules)",
        "--",
        "$(rootpath config/example.brenn)",
    ],
    data = [
        "config/example.brenn",
        "//spec:modules",
        "@brenn//:modules",
        "@brenn//brenn",
    ],
)
