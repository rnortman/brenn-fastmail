load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Built for the host here and again for wasm32 by the component that depends
# on it, through the component rule's platform transition. Its one
# dependency is the XML reader from this repository's own hub, which builds
# for both; no type of it appears in this crate's public API.
rust_library(
    name = "fastmail_dav",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "fastmail_dav",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = ["@fastmail_crates//:roxmltree"],
)

# Fixtures are read with include_str!, so they are compile inputs.
rust_test(
    name = "fastmail_dav_test",
    size = "small",
    compile_data = glob(["fixtures/*"]),
    crate = ":fastmail_dav",
)
