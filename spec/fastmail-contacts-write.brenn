/// Each user's Fastmail contacts written for an assistant over JMAP (RFC
/// 8620, RFC 9610 for contacts, RFC 9553 for the cards), as native tools,
/// each answered by `api-request` calls against the `api_key_provider` the
/// instance names. That provider holds one account per user, or several, each
/// a user's API token with read-write access to contacts; `api-request` picks
/// the calling user's, and attaches it host-side, so no token ever reaches
/// this component. The tools create a contact and change one; nothing here
/// deletes a contact or writes an address book.
///
/// Every capability is load-bearing: `config` names the provider and the
/// host, without which no call can be addressed; `store` carries each
/// request's state between the activation that issues its nested call and
/// the one that receives the answer; `tools` is the authority to call
/// `api-request`; `provides` is what makes the tools exist; `log` records each
/// step's tool, status and size — never a body or a header.
///
/// The instance's `config = { ... };` map is flat: `provider` is the
/// `api_key_provider` name, whose `account` blocks bind each user's token; `host` is the `host[:port]` Fastmail's JMAP API
/// is called on (`api.fastmail.com`), which `api-request` matches against that
/// provider's `api_hosts` and the instance's clauses must admit, for `GET
/// /jmap/session` and `POST /jmap/api`. A missing or malformed key fails every
/// activation, naming the key.
///
/// Size the instance's result inbox with a `channel at
/// "brenn:tool-results/<slug>"` block: each live request has at most one
/// nested call outstanding, so the window must hold Σ max_concurrency results,
/// twice over for a re-delivered result — `retain_depth ≥ 2 × Σ`, rounded up
/// to a power of two. This class's Σ is 2 + 2 = 4, so the family default of
/// 16 holds it.
///
/// Every nested answer crosses the bus as a tool result and must fit
/// `[messaging] max_body_bytes` (64 KiB default). An update first reads the
/// one list of the contact it changes, and its name; a list with long
/// entries, such as notes, can need the raised cap the read component's
/// documentation describes. An answer over the bus cap never reaches this
/// component, and the update is refused before anything is written.
component FastmailContactsWrite {
  abi = processor;
  requires = [log, store, config, tools, provides];
  in tool-results;
  in tool-requests;
  provide fastmail-contact-create {
    mcp_name = "FastmailContactCreate";
    description = "Create a contact in the user's Fastmail contacts. `account` names which of the user's Fastmail accounts, by the name the operator gave it — not the `account_id` `FastmailAddressBooks` answers, which is Fastmail's own id; omit it for the user's default or only account. A refusal listing account names means several are configured and none is the default: pass one. `address_book` (required) is the one address book the contact is created in, an `id` from `FastmailAddressBooks`: use the one marked `is_default` unless the user names another, and add the contact to others afterwards with `FastmailContactUpdate`'s `add_address_books`. Give at least one of: `name` (the full name as shown, prefix, middle name and suffix included), `given` and `surname` (those two parts of it; other parts cannot be set as parts), `emails`, `phones`, `online_services` (URIs), `addresses` (each a whole postal address as text), `organizations`, `titles`, `nicknames`, `notes` and `birthday` (1990-04-15, 1990-04, 1990, or --04-15 for a month and day). Each list holds bare values, no two the same: at most 10, `addresses` and `notes` at most 5. A text is at most 255 characters, a URI or an address 1000, a note 4000; only addresses and notes may hold line breaks. Labels, contexts, phone features, preference, a title's kind, an online service's name and user, and anniversaries other than a birthday are not set here: set them afterwards with `FastmailContactUpdate`, one entry per call, after `FastmailContactRead` shows the new contact's entry keys. The contact is created as an individual; groups, photos and a title's organization are not written. A refusal saying the text is too wide for one request asks for fewer or shorter entries. Answers the new contact's `id`. A refusal saying Fastmail refused `contact` carries Fastmail's reason, such as an address book that does not exist or that the user may not write to. A refusal saying the token cannot write contacts, or that Fastmail refused the token (HTTP 401 or 403), is the operator's to fix. If the answer is lost the contact may have been created: look for it with FastmailContactSearch before asking again, or the user has two.";
    input_schema = """{ "type": "object", "properties": { "address_book": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,255}$" }, "name": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "[^\\s\\u0085]" }, "given": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "[^\\s\\u0085]" }, "surname": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "[^\\s\\u0085]" }, "emails": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "[^\\s\\u0085]" } }, "phones": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "[^\\s\\u0085]" } }, "online_services": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "[^\\s\\u0085]" } }, "addresses": { "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "[^\\s\\u0085]" } }, "organizations": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "[^\\s\\u0085]" } }, "titles": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "[^\\s\\u0085]" } }, "nicknames": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "[^\\s\\u0085]" } }, "notes": { "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 4000, "pattern": "[^\\s\\u0085]" } }, "birthday": { "type": "string", "pattern": "^(\\d{4}(-\\d{2}(-\\d{2})?)?|--\\d{2}-\\d{2})$" }, "account": { "type": "string", "pattern": "^[a-z]([a-z0-9-]{0,253}[a-z0-9])?$" } }, "required": ["address_book"], "additionalProperties": false }""";
    max_concurrency = 2;
  }
  provide fastmail-contact-update {
    mcp_name = "FastmailContactUpdate";
    description = "Change one contact of the user's Fastmail contacts; everything the call does not name is kept as it is, including what these tools never show. `account` names which of the user's Fastmail accounts, by the name the operator gave it — not the `account_id` `FastmailAddressBooks` answers, which is Fastmail's own id; omit it for the user's default or only account. A refusal listing account names means several are configured and none is the default: pass one. `id` (required) is a contact `id` from `FastmailContactSearch`. Give at least one change. The name: `name` sets the full name as shown and nothing else; `given` and `surname` set those parts and nothing else, so a change to both the text and a part gives both, and a part change on a contact that has a full name must come with `name`. Other parts (prefix, middle name, suffix) are kept; a name whose parts cannot be placed without guessing (two of one kind, or a missing part in an ordered name) is refused: set `name` and edit the parts in Fastmail. Address books: `add_address_books` and `remove_address_books`, at most 10 `id`s each from `FastmailAddressBooks`, none in both; a contact must stay in at least one. One entry per call: `list` is one of `emails`, `phones`, `online_services`, `addresses`, `organizations`, `titles`, `nicknames`, `anniversaries`, `notes`; `key` is the entry's `key` from `FastmailContactRead`. Without `key` the call adds a new entry; with `key` it changes only the fields given; with `key` and `remove: true` it removes the entry, which cannot be undone from Fastmail. The fields each list takes, `value` being its main text: `emails` (`value` the address; `label`, `contexts`, `pref`), `phones` (`value` the number; `label`, `contexts`, `features`, `pref`), `online_services` (`value` the URI, up to 1000 characters; `service`, `user`, `label`, `contexts`, `pref`; an add needs `value` or `user`), `addresses` (`value` the whole address as text, up to 1000 characters, line breaks allowed; `country_code`, two capital letters; `contexts`, `pref`), `organizations` (`value` the name), `titles` (`value` the title; `kind`: `title` or `role`), `nicknames` (`value`; `contexts`, `pref`), `anniversaries` (`value` the date: 1990-04-15, 1990-04, 1990, or --04-15; `kind`: `birth`, `death` or `wedding`, required on an add), `notes` (`value` the note, up to 4000 characters, line breaks allowed). Every other text is at most 255 characters on one line. `contexts` is the entry's whole set of `private` and `work` (an address also `billing` and `delivery`) and `features` the phone's whole set of `mobile`, `voice`, `text`, `video`, `main-number`, `textphone`, `fax`, `pager`; `pref` is 1-100, lower preferred. A field cannot be cleared in place: remove the entry and add it again. Editing an address's text drops the parts it was stored as. A title's organization and an organization's units cannot be set and survive an edit; if Fastmail refuses removing an organization a title is held at, remove the title first. Answers `id`, `updated` (which of `name`, `address_books` and the list changed) and, on an add, the new entry's `key`. A refusal saying the contacts changed while the update was prepared changed nothing: ask again. A refusal naming a key the contact does not have, or saying Fastmail refused the contact, carries the reason. A refusal saying the token cannot write contacts, or that Fastmail refused the token (HTTP 401 or 403), is the operator's to fix. A refusal naming `max_response_bytes` or `max_body_bytes` means the contact's list is too large to read: the operator raises that setting. If the answer is lost the change may have been applied: read the contact with FastmailContactRead before asking again, since an add asked twice adds twice.";
    input_schema = """{ "type": "object", "properties": { "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,255}$" }, "name": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "[^\\s\\u0085]" }, "given": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "[^\\s\\u0085]" }, "surname": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "[^\\s\\u0085]" }, "add_address_books": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,255}$" } }, "remove_address_books": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,255}$" } }, "list": { "type": "string", "enum": ["emails", "phones", "online_services", "addresses", "organizations", "titles", "nicknames", "anniversaries", "notes"] }, "key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,255}$" }, "remove": { "type": "boolean" }, "value": { "type": "string", "minLength": 1, "maxLength": 4000, "pattern": "[^\\s\\u0085]" }, "label": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "[^\\s\\u0085]" }, "contexts": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "type": "string", "enum": ["private", "work", "billing", "delivery"] } }, "features": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "enum": ["mobile", "voice", "text", "video", "main-number", "textphone", "fax", "pager"] } }, "pref": { "type": "integer", "minimum": 1, "maximum": 100 }, "kind": { "type": "string", "enum": ["title", "role", "birth", "death", "wedding"] }, "service": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "[^\\s\\u0085]" }, "user": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "[^\\s\\u0085]" }, "country_code": { "type": "string", "pattern": "^[A-Z]{2}$" }, "account": { "type": "string", "pattern": "^[a-z]([a-z0-9-]{0,253}[a-z0-9])?$" } }, "required": ["id"], "additionalProperties": false }""";
    max_concurrency = 2;
  }
}
